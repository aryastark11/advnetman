[Unit]
Description=Automated Network Device Password Rotation via HashiCorp Vault & eAPI
After=network.target docker.service

[Service]
Type=oneshot
User=student
WorkingDirectory=/home/student/Desktop/lab1
ExecStart=/usr/bin/python3 /home/student/Desktop/lab1/scripts/rotate_passwords.py --stagger 3.0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
