# RCN NetSleuth AI Environment Configuration Template
# CSCI 5840 Labs 9–10 Hackathon Edition
# COPY THIS FILE TO .env AND POPULATE SECRETS. NEVER COMMIT .env TO GIT.

# Gemini LLM Configuration
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-2.5-flash"

# HashiCorp Vault Secrets Management
VAULT_ADDR="https://127.0.0.1:8200"
VAULT_CACERT="vault/certs/ca.crt"
VAULT_ROLE_ID="netsleuth-approle-id"
VAULT_SECRET_ID="netsleuth-approle-secret"
# Optional fallback token for local dev/testing
VAULT_DEV_TOKEN=""

# InfluxDB Telemetry Pipeline
INFLUX_URL="http://127.0.0.1:8086"
INFLUX_TOKEN="csci5840-influxdb-telemetry-token"
INFLUX_ORG="csci5840"
INFLUX_BUCKET="telemetry"

# NetSleuth Application Server
NETSLEUTH_HOST="0.0.0.0"
NETSLEUTH_PORT=8000
NETSLEUTH_DB_PATH="netsleuth.db"
NETSLEUTH_SYNTHETIC_PROBE_INTERVAL=10
